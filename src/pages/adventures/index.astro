---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const adventures = (await getCollection(
  "adventures",
  ({ data }) => data.published
)).sort((a, b) => a.data.title.localeCompare(b.data.title));

const getAdventureId = (adventure) =>
  adventure.data.id ?? adventure.id.replace(/\.aia$/, "");
---

<Layout title="Adventures | AI Adventure">
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">Choose your story</p>
      <h1>Adventures</h1>

      <p class="introduction">
        Choose an adventure, select how you want it played, then copy the launch prompt into ChatGPT.
      </p>
    </header>

    <section class="adventure-grid">
      {
        adventures.map((adventure) => {
          const adventureId = getAdventureId(adventure);

          return (
            <article class="adventure-card">
              {adventure.data.featured && (
                <span class="badge">Featured adventure</span>
              )}

              <h2>
                <a href={`/adventures/${adventureId}/`}>
                  {adventure.data.title}
                </a>
              </h2>

              <p>{adventure.data.description}</p>

              <dl>
                <div>
                  <dt>Genre</dt>
                  <dd>{adventure.data.genre}</dd>
                </div>

                <div>
                  <dt>Challenge</dt>
                  <dd>{adventure.data.challenge}</dd>
                </div>

                <div>
                  <dt>Typical journey</dt>
                  <dd>{adventure.data.typicalJourney}</dd>
                </div>
              </dl>

              <div class="card-actions">
                <a class="button" href={`/launcher/?adventure=${adventureId}`}>
                  Play this one
                </a>

                <a class="text-link" href={`/adventures/${adventureId}/`}>
                  More details
                </a>
              </div>
            </article>
          );
        })
      }
    </section>
  </main>
</Layout>
