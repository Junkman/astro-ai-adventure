---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (async () => {
  const adventures = await getCollection(
    "adventures",
    ({ data }) => data.published
  );

  return adventures.map((adventure) => {
    const id =
      adventure.data.id ??
      adventure.id.replace(/\.aia$/, "");

    return {
      params: {
        id,
      },
      props: {
        adventure,
      },
    };
  });
}) satisfies GetStaticPaths;

const { adventure } = Astro.props;
---

<Layout title={`${adventure.data.title} | AI Adventure`}>
  <main class="page">
    <article class="adventure-page">
      <p>
        <a href="/adventures/">← All adventures</a>
      </p>

      <header class="page-header">
        <p class="eyebrow">{adventure.data.genre}</p>
        <h1>{adventure.data.title}</h1>
        <p class="introduction">{adventure.data.description}</p>
      </header>

      <dl class="adventure-details">
        <div>
          <dt>Challenge</dt>
          <dd>{adventure.data.challenge}</dd>
        </div>

        <div>
          <dt>Typical journey</dt>
          <dd>{adventure.data.typicalJourney}</dd>
        </div>

        <div>
          <dt>Version</dt>
          <dd>{adventure.data.version}</dd>
        </div>

        <div>
          <dt>Author</dt>
          <dd>{adventure.data.author}</dd>
        </div>
      </dl>

      <div class="content">
        <h2>About {adventure.data.title}</h2>
        <p>{adventure.data.description}</p>
      </div>
    </article>
  </main>
</Layout>