---
import Layout from "../layouts/Layout.astro";
---

<Layout title="AI Adventure">
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">Stories you can explore</p>

      <h1>AI Adventure</h1>

      <p class="introduction">
        Interactive adventures powered by your choice of AI.
      </p>
    </header>

    <p>
      AI Adventure provides stories and game-master instructions that
      turn compatible AI systems into interactive adventure games.
    </p>

    <p>
      <a class="button" href="/adventures/">
        Explore the adventures
      </a>
    </p>
  </main>
</Layout>