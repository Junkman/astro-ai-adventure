---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | AI Adventure">
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">About</p>

      <h1>About AI Adventure</h1>

      <p class="introduction">
        AI Adventure is an open format for creating and playing interactive adventures using modern AI.
      </p>
    </header>

    <p>
      Every adventure describes a world rather than a script, allowing the AI
      to create a unique experience while remaining faithful to the author's
      vision.
    </p>

    <p>
      This project is currently under active development.
    </p>
  </main>
</Layout>