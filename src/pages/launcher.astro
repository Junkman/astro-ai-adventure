---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const adventures = (await getCollection(
  "adventures",
  ({ data }) => data.published
)).map((adventure) => ({
  id: adventure.id,
  title: adventure.data.title,
  description: adventure.data.description,
  playTime: adventure.data.playTime,
}));
---

<Layout title="Launch an Adventure | AI Adventure">
  <main class="page launcher-page">
    <header class="page-header">
      <p class="eyebrow">Set your experience</p>
      <h1 id="launcher-title">Launch Adventure</h1>
      <p class="introduction" id="launcher-description">
        Choose an adventure from the Adventures page to begin.
      </p>
    </header>

    <div id="launcher-error" class="notice notice--error" hidden>
      The selected adventure could not be found.
      <a href="/adventures/">Return to Adventures</a>.
    </div>

    <form id="launcher-form" class="launcher-form" hidden>
      <input type="hidden" id="adventure-id" name="adventure" />

      <fieldset class="launcher-option">
        <legend>Playing style</legend>
        <p class="option-help">How readily should ChatGPT help when you become stuck?</p>

        <label class="choice-card">
          <input type="radio" name="style" value="Helpful" />
          <span>
            <strong>Helpful</strong>
            <small>Offers gentle hints when needed.</small>
          </span>
        </label>

        <label class="choice-card">
          <input type="radio" name="style" value="Balanced" checked />
          <span>
            <strong>Balanced</strong>
            <small>Allows exploration before offering subtle help.</small>
          </span>
        </label>

        <label class="choice-card">
          <input type="radio" name="style" value="Strict" />
          <span>
            <strong>Strict</strong>
            <small>Provides no unsolicited hints.</small>
          </span>
        </label>

        <label class="choice-card">
          <input type="radio" name="style" value="Deadly" />
          <span>
            <strong>Deadly</strong>
            <small>Poor choices may have lasting consequences.</small>
          </span>
        </label>
      </fieldset>

      <fieldset class="launcher-option">
        <legend>Target playing time</legend>
        <p class="option-help">ChatGPT will adjust pacing rather than simply stopping at the clock.</p>

        <div class="choice-row">
          <label><input type="radio" name="time" value="15 minutes" /> 15 minutes</label>
          <label><input type="radio" name="time" value="30 minutes" checked /> 30 minutes</label>
          <label><input type="radio" name="time" value="60 minutes" /> 60 minutes</label>
          <label><input type="radio" name="time" value="Open-ended" /> Open-ended</label>
        </div>
      </fieldset>

      <fieldset class="launcher-option">
        <legend>Randomness</legend>
        <p class="option-help">How much freedom should ChatGPT use when bringing the adventure to life?</p>

        <div class="choice-row">
          <label><input type="radio" name="randomness" value="Low" /> Low</label>
          <label><input type="radio" name="randomness" value="Medium" checked /> Medium</label>
          <label><input type="radio" name="randomness" value="High" /> High</label>
        </div>
      </fieldset>

      <button class="button launcher-generate" type="submit">Generate launch prompt</button>
    </form>

    <section id="prompt-panel" class="prompt-panel" hidden aria-live="polite">
      <h2>Your ChatGPT launch prompt</h2>
      <p>Copy this text into a new ChatGPT conversation.</p>
      <textarea id="launch-prompt" rows="13" readonly></textarea>
      <div class="prompt-actions">
        <button class="button" id="copy-prompt" type="button">Copy prompt</button>
        <span id="copy-status" role="status"></span>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ adventures }}>
  const params = new URLSearchParams(window.location.search);
  const adventureId = params.get("adventure");
  const adventure = adventures.find((item) => item.id === adventureId);

  const form = document.querySelector("#launcher-form");
  const error = document.querySelector("#launcher-error");
  const title = document.querySelector("#launcher-title");
  const description = document.querySelector("#launcher-description");
  const adventureInput = document.querySelector("#adventure-id");
  const promptPanel = document.querySelector("#prompt-panel");
  const promptOutput = document.querySelector("#launch-prompt");
  const copyButton = document.querySelector("#copy-prompt");
  const copyStatus = document.querySelector("#copy-status");

  if (!adventure) {
    error.hidden = false;
  } else {
    title.textContent = `Play ${adventure.title}`;
    description.textContent = adventure.description;
    adventureInput.value = adventure.id;
    form.hidden = false;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const style = data.get("style");
    const targetTime = data.get("time");
    const randomness = data.get("randomness");
    const origin = window.location.origin;

    const guideUrl = `${origin}/AI-Adventure-Guide.md`;
    const adventureUrl = `${origin}/adventures/${adventure.id}.aia.md`;

    promptOutput.value = `Refer to and follow:\n${guideUrl}\n\nPlay the adventure at:\n${adventureUrl}\n\nSettings:\nPlaying style: ${style}\nTarget time: ${targetTime}\nRandomness: ${randomness}\n\nBegin the adventure without revealing hidden information.`;

    promptPanel.hidden = false;
    copyStatus.textContent = "";
    promptPanel.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(promptOutput.value);
      copyStatus.textContent = "Copied.";
    } catch {
      promptOutput.focus();
      promptOutput.select();
      copyStatus.textContent = "Select the prompt and copy it manually.";
    }
  });
</script>
