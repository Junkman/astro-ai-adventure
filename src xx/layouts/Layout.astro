---
import "../styles/global.css";

const { title = "AI Adventure" } = Astro.props;
const currentPath = Astro.url.pathname;

const navigation = [
  { href: "/", label: "Home" },
  { href: "/adventures/", label: "Adventures" },
  { href: "/format/", label: "Format" },
  { href: "/about/", label: "About" },
];

const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Interactive adventures powered by your choice of AI."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label="AI Adventure home">
          <span class="site-brand__name">AI Adventure</span>
          <span class="site-brand__tagline">Open adventures for AI</span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class:list={["site-nav__link", { "is-current": isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>
